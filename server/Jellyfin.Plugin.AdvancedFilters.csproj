<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.AdvancedFilters</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.AdvancedFilters</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" PrivateAssets="all" />
    <EmbeddedResource Include="../dist/library-filter.js" LogicalName="AdvancedFilters.client.js" />
    <EmbeddedResource Include="config.html" LogicalName="AdvancedFilters.config.html" />
  </ItemGroup>
</Project>
